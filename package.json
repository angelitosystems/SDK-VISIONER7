  },
  "devDependencies": {
    "@nestjs/axios": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@types/node": "^26.5.0",
    "axios": "^1.20.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.1",
    "typescript": "^7.0.2"
  }
